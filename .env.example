# Copy to .env and set at least one key. With several, `make cv` picks among them at random.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint, for example a local Ollama server:
# OPENAI_BASE_URL=http://localhost:11434/v1
# CVELIO_MODEL=llama3.3

# Optional overrides
# CVELIO_PROVIDER=anthropic
# CVELIO_MODEL=claude-opus-5-5
# OPENROUTER_MODEL=openai/gpt-6-luna      # per provider: <PROVIDER>_MODEL
# CVELIO_PROFILE=~/.config/cvelio/profile.yaml

# Only for `make enrich`
# APIFY_TOKEN=
# GITHUB_TOKEN=

# Keys in AWS Parameter Store instead (or answer the question in `make init`)
# CVELIO_SSM_PREFIX=/myteam/keys/
# CVELIO_SSM_REGION=us-east-1
